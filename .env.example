# The app automatically uses proposal/demo mode when Supabase is not configured.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEMO_MODE=true

# Public client-safe Supabase values. Never place a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets belong in Supabase Edge Function secrets, not in this file:
# OPENAI_API_KEY=...
# OPENAI_GARMENT_MODEL=gpt-5.6
