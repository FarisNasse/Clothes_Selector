# Copy this file to .env before editing. Expo does not load .env.example.
# With no .env, demo mode is the default. Restart Expo after changing .env.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEMO_MODE=true

# Public client-safe Supabase values. Never place a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets belong in Supabase Edge Function secrets, not in this file:
# OPENAI_API_KEY=...
# OPENAI_GARMENT_MODEL=gpt-5.6
