{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "react", "react-native"]
  },
  "include": ["app", "src", "tests", "expo-env.d.ts", ".expo/types/**/*.ts"]
}
