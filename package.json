{
  "name": "clothes-selector",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "doctor": "npx expo-doctor@latest",
    "repair:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repair-expo-web.ps1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@expo/vector-icons": "^15.1.1",
    "@supabase/supabase-js": "^2.0.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.86.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "~6.0.3"
  }
}
